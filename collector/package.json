{
  "name": "collector",
  "version": "0.1.0",
  "description": "YouTubeチャンネル情報を収集・分析するツール",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "tsx src/index.ts",
    "start:full": "tsx src/index.ts --full",
    "dev": "DRY_RUN=true tsx src/index.ts",
    "watch": "tsc --watch",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "googleapis": "^144.0.0",
    "nanoid": "^5.1.6"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.19.2",
    "typescript": "~5.9.3"
  },
  "pnpm": {
    "overrides": {
      "qs": ">=6.14.2"
    }
  }
}
